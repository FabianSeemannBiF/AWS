name <- c("Susi", "Tim", "Christine", "Mathias")
job <- c(rep("Student(in)", 3), "angestellt")
job <- factor(job, levels = c("Student(in)", "angestellt", "selbstständig"))
figur <- c(rep("mollig", 2), "muskulös", "hager")
figur <- ordered(figur, levels = c("hager", "dünn", "schlank", "normal", 
                                   "mollig", "muskulös"))
groesse <- c(1.97, 1.67, 1.9, 1.81)
gewicht <- c(98L, 89L, 71L, 86L)
trinkt <- c(TRUE, NA, TRUE, TRUE)

# 2.
Freunde <- data.frame(Name = name, Figur = figur, Groesse = groesse,
                      Gewicht = gewicht, Trinkt = trinkt, Beruf = job,
                      stringsAsFactors = FALSE)
Freunde
str(Freunde)

